# IMovies Backend Environment Variables Example

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/imovies?retryWrites=true&w=majority

# Client Application URL
CLIENT_URL=http://localhost:5173

# Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRY=7d

# Seat Booking Concurrency Control
SEAT_LOCK_EXPIRY_MINUTES=10

# Payment Gateway (Razorpay Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Upload Storage Configuration
UPLOAD_DIR=./uploads

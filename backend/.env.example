# ==========================================
# IMovies Backend Environment Configuration
# ==========================================

# Server Port and Mode
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@chat-db.8ywxpr8.mongodb.net/imovies?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# Frontend Application Client URL (Your Vercel deployment URL)
# Example: https://imovies-app.vercel.app
CLIENT_URL=http://localhost:5173

# Security & JSON Web Tokens
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
JWT_REFRESH_EXPIRY=7d

# Seat Lock Duration (Minutes)
SEAT_LOCK_EXPIRY_MINUTES=10

# Razorpay Test Credentials (or use mock keys for testing)
RAZORPAY_KEY_ID=rzp_test_imovies_mock_key
RAZORPAY_KEY_SECRET=rzp_test_imovies_mock_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_imovies_webhook_secret
